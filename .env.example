# Run the interactive wizard: npm run setup

# Single project (legacy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_PROJECT_NAME=default

# Or use a service role key instead of the anon key:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Multiple projects (takes precedence over single-project vars)
# SUPABASE_PROJECTS=[{"name":"app-one","url":"https://project-one.supabase.co","anonKey":"anon-key-one"},{"name":"app-two","url":"https://project-two.supabase.co","anonKey":"anon-key-two"}]
