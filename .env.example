# Run the interactive wizard: npm run setup

# Single project (legacy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_PROJECT_NAME=default
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_TABLE=_keepalive

# Multiple projects (takes precedence over single-project vars)
# SUPABASE_PROJECTS=[{"name":"app-one","url":"https://project-one.supabase.co","anonKey":"anon-key-one"},{"name":"app-two","url":"https://project-two.supabase.co","anonKey":"anon-key-two","serviceRoleKey":"service-role-key-two","table":"_keepalive"}]

# Run npm run setup to create _keepalive tables automatically, or sql/keepalive.sql manually.
# Start the keep-alive service with: npm start
# Ping interval in days (default: 1). Free projects pause after ~7 days of inactivity.
# PING_INTERVAL_DAYS=1
